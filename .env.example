# ===== Llaves de Melsprout — PLANTILLA (sin secretos reales) =====
# Copia este archivo como ".env.local" y pega tus llaves de Supabase.
# NUNCA subas ".env.local" a internet (ya está protegido en .gitignore).

# Se encuentran en: Supabase → tu proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# SECRET key (llave maestra) — SOLO servidor, para códigos de respaldo.
# ¡NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la subas a internet!
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# La URL pública de tu sitio (en desarrollo es localhost; en producción, tu dominio)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
